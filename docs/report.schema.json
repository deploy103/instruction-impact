{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/deploy103/instruction-impact/blob/main/docs/report.schema.json",
  "title": "Instruction impact report v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "base", "head", "profile", "instruction_names", "instruction_changes", "affected_files", "summary"],
  "properties": {
    "schema_version": {"const": 2},
    "base": {"$ref": "#/$defs/oid"},
    "head": {"$ref": "#/$defs/oid"},
    "profile": {"enum": ["agents", "codex"]},
    "instruction_names": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "instruction_changes": {"type": "array", "items": {"$ref": "#/$defs/instruction"}},
    "affected_files": {"type": "array", "items": {"$ref": "#/$defs/file"}},
    "summary": {
      "type": "object", "additionalProperties": false,
      "required": ["instruction_changes", "affected_files", "unchanged_files_affected", "existing_files_affected"],
      "properties": {
        "instruction_changes": {"type": "integer", "minimum": 0},
        "affected_files": {"type": "integer", "minimum": 0},
        "unchanged_files_affected": {"type": "integer", "minimum": 0},
        "existing_files_affected": {"type": "integer", "minimum": 0}
      }
    }
  },
  "$defs": {
    "oid": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"},
    "nullableOid": {"anyOf": [{"$ref": "#/$defs/oid"}, {"type": "null"}]},
    "source": {
      "type": "object", "additionalProperties": false, "required": ["path", "blob"],
      "properties": {"path": {"type": "string"}, "blob": {"$ref": "#/$defs/oid"}}
    },
    "cause": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "kind", "before_blob", "after_blob"],
      "properties": {
        "path": {"type": "string"},
        "kind": {"enum": ["added", "removed", "modified"]},
        "before_blob": {"$ref": "#/$defs/nullableOid"},
        "after_blob": {"$ref": "#/$defs/nullableOid"}
      }
    },
    "instruction": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "kind", "before_blob", "after_blob", "before_state", "after_state", "diff", "affected_files"],
      "properties": {
        "path": {"type": "string"},
        "kind": {"enum": ["added", "removed", "modified"]},
        "before_blob": {"$ref": "#/$defs/nullableOid"},
        "after_blob": {"$ref": "#/$defs/nullableOid"},
        "before_state": {"enum": ["missing", "selected", "shadowed", "empty"]},
        "after_state": {"enum": ["missing", "selected", "shadowed", "empty"]},
        "diff": {"type": "string"},
        "affected_files": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "file": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "status", "file_changed", "before", "after", "causes"],
      "properties": {
        "path": {"type": "string"},
        "status": {"enum": ["added", "deleted", "existing"]},
        "file_changed": {"type": "boolean"},
        "before": {"type": "array", "items": {"$ref": "#/$defs/source"}},
        "after": {"type": "array", "items": {"$ref": "#/$defs/source"}},
        "causes": {"type": "array", "items": {"$ref": "#/$defs/cause"}}
      }
    }
  }
}
